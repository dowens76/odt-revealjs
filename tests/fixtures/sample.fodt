<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:meta="urn:oasis:names:tc:opendocument:xmlns:meta:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:math="http://www.w3.org/1998/Math/MathML" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
 <office:meta><dc:title>Sample Lecture</dc:title></office:meta>
 <office:font-face-decls><style:font-face style:name="Liberation Mono" svg:font-family="&apos;Liberation Mono&apos;" style:font-family-generic="modern" style:font-pitch="fixed"/></office:font-face-decls>
 <office:styles>
  <style:style style:name="Standard" style:family="paragraph"/>
  <style:style style:name="Heading" style:family="paragraph" style:parent-style-name="Standard"/>
  <style:style style:name="Text_20_body" style:display-name="Text body" style:family="paragraph" style:parent-style-name="Standard"/>
  <style:style style:name="Heading_20_1" style:display-name="Heading 1" style:family="paragraph" style:parent-style-name="Heading" style:default-outline-level="1"/>
  <style:style style:name="Heading_20_2" style:display-name="Heading 2" style:family="paragraph" style:parent-style-name="Heading" style:default-outline-level="2"/>
  <style:style style:name="Title" style:family="paragraph" style:parent-style-name="Heading"/>
  <style:style style:name="Subtitle" style:family="paragraph" style:parent-style-name="Heading"/>
  <style:style style:name="Quotations" style:family="paragraph" style:parent-style-name="Standard"/>
  <style:style style:name="Preformatted_20_Text" style:display-name="Preformatted Text" style:family="paragraph" style:parent-style-name="Standard"><style:text-properties style:font-name="Liberation Mono"/></style:style>
  <style:style style:name="Speaker_20_Notes" style:display-name="Speaker Notes" style:family="paragraph" style:parent-style-name="Text_20_body"/>
  <style:style style:name="Strong_20_Emphasis" style:display-name="Strong Emphasis" style:family="text"><style:text-properties fo:font-weight="bold"/></style:style>
  <style:style style:name="Emphasis" style:family="text"><style:text-properties fo:font-style="italic"/></style:style>
  <style:style style:name="Draft_20_Marker" style:display-name="Draft Marker" style:family="text"><style:text-properties fo:color="#ff0000"/></style:style>
 </office:styles>
 <office:automatic-styles>
  <style:style style:name="P1" style:family="paragraph" style:parent-style-name="Text_20_body"><style:paragraph-properties fo:text-align="justify"/></style:style>
  <style:style style:name="T1" style:family="text"><style:text-properties fo:font-weight="bold"/></style:style>
  <style:style style:name="T2" style:family="text"><style:text-properties style:text-position="super 58%"/></style:style>
  <style:style style:name="fr1" style:family="graphic"/>
  <text:list-style style:name="L1"><text:list-level-style-number text:level="1" style:num-format="1" style:num-suffix="."/></text:list-style>
  <text:list-style style:name="L2"><text:list-level-style-bullet text:level="1" text:bullet-char="•"/><text:list-level-style-bullet text:level="2" text:bullet-char="◦"/></text:list-style>
 </office:automatic-styles>
 <office:body><office:text>
  <text:p text:style-name="Title">Sample Lecture</text:p>
  <text:p text:style-name="Subtitle">A test document</text:p>
  <text:h text:style-name="Heading_20_1" text:outline-level="1">Introduction</text:h>
  <text:p text:style-name="P1">This has <text:span text:style-name="Strong_20_Emphasis">strong</text:span>, <text:span text:style-name="Emphasis">emphasis</text:span>, <text:span text:style-name="T1">direct bold</text:span>, E=mc<text:span text:style-name="T2">2</text:span> and a <text:a xlink:type="simple" xlink:href="https://example.com/">link</text:a>.<text:note text:id="ftn1" text:note-class="footnote"><text:note-citation>1</text:note-citation><text:note-body><text:p text:style-name="Standard">A footnote.</text:p></text:note-body></text:note> <text:span text:style-name="Draft_20_Marker">[TODO remove]</text:span></text:p>
  <text:p text:style-name="Speaker_20_Notes">Remember to smile.</text:p>
  <text:h text:style-name="Heading_20_2" text:outline-level="2">Lists &amp; Tables</text:h>
  <text:list text:style-name="L2"><text:list-item><text:p text:style-name="Text_20_body">Bullet one</text:p><text:list><text:list-item><text:p text:style-name="Text_20_body">Nested</text:p></text:list-item></text:list></text:list-item><text:list-item><text:p text:style-name="Text_20_body">Bullet two</text:p></text:list-item></text:list>
  <text:list text:style-name="L1"><text:list-item><text:p text:style-name="Text_20_body">First</text:p></text:list-item><text:list-item><text:p text:style-name="Text_20_body">Second</text:p></text:list-item></text:list>
  <table:table table:name="T"><table:table-column table:number-columns-repeated="2"/><table:table-header-rows><table:table-row><table:table-cell><text:p>Name</text:p></table:table-cell><table:table-cell><text:p>Value</text:p></table:table-cell></table:table-row></table:table-header-rows><table:table-row><table:table-cell><text:p>a</text:p></table:table-cell><table:table-cell><text:p>1</text:p></table:table-cell></table:table-row></table:table>
  <text:h text:style-name="Heading_20_2" text:outline-level="2">A Picture</text:h>
  <text:p text:style-name="Text_20_body"><draw:frame draw:style-name="fr1" draw:name="Image1" text:anchor-type="as-char" svg:width="4cm" svg:height="2cm"><draw:image><office:binary-data>iVBORw0KGgoAAAANSUhEUgAAACgAAAAUCAIAAABwJOjsAAAAJElEQVR4nGM4YWMzIIhh1OJRi0ctHrV41OJRi0ctHrV45FgMAGQL6C7l1KfNAAAAAElFTkSuQmCC</office:binary-data></draw:image><svg:title>Red box</svg:title></draw:frame></text:p>
  <text:h text:style-name="Heading_20_1" text:outline-level="1">Maths</text:h>
  <text:p text:style-name="Text_20_body"><draw:frame draw:name="Formula1" text:anchor-type="as-char" svg:width="2cm" svg:height="0.5cm"><draw:object><math:math><math:semantics><math:mrow><math:mi>a</math:mi><math:mo>+</math:mo><math:mi>b</math:mi></math:mrow><math:annotation math:encoding="StarMath 5.0">a+b</math:annotation></math:semantics></math:math></draw:object></draw:frame></text:p>
  <text:h text:style-name="Heading_20_1" text:outline-level="1">Appendix</text:h>
  <text:p text:style-name="Preformatted_20_Text">let x = 1;</text:p>
  <text:p text:style-name="Preformatted_20_Text">let y = <text:s text:c="2"/>2;</text:p>
  <text:p text:style-name="Quotations">To be or not to be.</text:p>
 </office:text></office:body>
</office:document>